# Bắt buộc
DISCORD_TOKEN=your-discord-bot-token
GEMINI_API_KEY=your-gemini-api-key
# Lưu phiên chat + lưu trữ vĩnh viễn (MongoDB Atlas). Bỏ trống = tắt bộ nhớ phiên
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Tuỳ chọn
# GUILD_ID=123456789012345678      # sync slash command tức thì cho 1 server (khi test)
# PORT=10000                       # cổng web server /health (mặc định 10000)
# --- Model ---
# GEMINI_API_VERSION=              # bỏ trống = dùng mặc định của SDK (v1). Đặt v1beta nếu thiếu tính năng/model preview
# HIDDEN_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro,gemini-nano-banana-2.1,gemini-omni-flash-preview,gemini-4-argon,gemini-4-carbon
#                                  # model ẩn khỏi gợi ý của option `model` (hỗ trợ dấu *, vd gemini-4-*). Đặt rỗng để hiện hết
# HIDE_PRO_MODELS=1               # 1 = ẩn toàn bộ model Pro khỏi gợi ý (đặt 0 để hiện lại)
# EXTRA_MODELS=gemini-4-hydrogen   # model thêm tay vào gợi ý, luôn hiện (mặc định: gemini-4-hydrogen). Đặt biến này sẽ thay mặc định
# AUTO_LAST_MODEL=gemini-4-hydrogen # bước cuối của chuỗi tự động (flash-lite → flash → AUTO_LAST_MODEL)
# AUTO_MODEL_CHAIN=                # tự quy định toàn bộ thứ tự, vd: gemini-3.5-flash-lite,gemini-3.8-flash,gemini-4-hydrogen
# DEFAULT_TEXT_MODEL=              # ép 1 model đứng đầu chuỗi tự động
# USER_COOLDOWN=5                  # giây giữa 2 lần /ask của 1 người
# MAX_CONCURRENT=2                 # số request Gemini chạy song song
# MODEL_REFRESH_HOURS=6            # chu kỳ làm mới danh sách model
# RAM_LIMIT_MB=256                 # ép giới hạn RAM hiển thị ở /status (nếu số đọc được sai)
# SYSTEM_PROMPT=...                # tính cách/quy tắc trả lời của bot

# STATUS_ALLOWED_IDS=1240503090185109536,1568530089035956284  # Discord ID được dùng /status (cách nhau bằng dấu phẩy)

# Phiên chat
# MONGODB_DB=gemini_bot            # tên database
# SESSION_IDLE_HOURS=2             # không chat quá số giờ này thì phiên tự được lưu trữ + làm mới
# SESSION_MAX_TURNS=500            # quá số lượt này phiên tự được lưu trữ + mở phiên mới
# MAX_HISTORY_MESSAGES=20          # số tin nhắn gần nhất (người dùng + bot) mỗi phiên nhớ làm ngữ cảnh
# MAX_HISTORY_CHARS=24000          # tổng ký tự lịch sử gửi kèm mỗi lần hỏi
# SWEEP_MINUTES=5                  # chu kỳ quét phiên hết hạn để lưu trữ
# MONGODB_QUOTA_MB=512             # dung lượng gói Atlas, chỉ để hiển thị ở /status

# --- Bảo mật Dashboard ---
# SESSION_SECRET=                  # >= 32 ký tự ngẫu nhiên để ký cookie HMAC-SHA256
# PASSWORD_PEPPER=                 # >= 32 ký tự ngẫu nhiên để tiền băm HMAC-SHA256 mật khẩu Admin
# SESSION_MAX_AGE_SECONDS=86400    # thời hạn cookie phiên (giây, mặc định 24 giờ)

# --- Cloudflare Tunnel & Proxy Headers (nạp sẵn khi khởi động nếu MongoDB chưa lưu token) ---
# CF_TUNNEL_TOKEN=                 # hoặc dùng CLOUDFLARE_TUNNEL_TOKEN
# CF_TUNNEL_MODE=named             # named | quick
# CF_TUNNEL_ONLY=false             # true = chỉ nhận truy cập qua Cloudflare Tunnel (giữ mở /health)
# TRUST_PROXY_HEADERS=false        # true = đọc X-Forwarded-Proto/For và CF-Connecting-IP từ proxy tin cậy
# TRUSTED_PROXY_IPS=               # tùy chọn IP/CIDR reverse proxy tin cậy (mặc định chỉ loopback)
# CLOUDFLARE_TUNNEL_SECRET_HEADER= # tùy chọn tên header bí mật do Cloudflare Transform Rule chèn
# CLOUDFLARE_TUNNEL_SECRET_VALUE=  # tùy chọn giá trị header bí mật
# OUTBOUND_PROXY_URL=              # tùy chọn ghi đè proxy outbound cho Discord & Gemini SDK
#
# --- Cloudflare WARP User-Space Proxy (127.0.0.1:40000, ~30 MB RAM, tự động fallback Direct) ---
# WARP_ENABLED=true                # true = tự khởi động warp-svc chế độ proxy trong container (non-blocking 5s)
# WARP_OUTBOUND_ENABLED=true       # bật/tắt định tuyến Gemini & Discord qua WARP mặc định (đổi nóng trên Dashboard)
# WARP_PROXY_PORT=40000            # cổng proxy cục bộ của WARP (mặc định 40000)
# WARP_STARTUP_TIMEOUT=5           # thời gian chờ tối đa (giây) khi khởi động WARP trong entrypoint
# WARP_LICENSE_KEY=                # tùy chọn WARP+ license key (không bao giờ lưu DB hay xuất API)
# WARP_CONNECTOR_TOKEN=            # tùy chọn Cloudflare Zero Trust WARP Connector token
