# ==============================================================================
# BẮT BUỘC
# ==============================================================================
DISCORD_TOKEN=your-discord-bot-token
GEMINI_API_KEY=your-gemini-api-key
# MongoDB Atlas URI (bắt buộc để lưu cấu hình động, tài khoản Dashboard & phiên chat)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gemini_bot

# ==============================================================================
# WEB DASHBOARD & XÁC THỰC KÉP (BỔ SUNG MỚI)
# ==============================================================================
PORT=10000
# Khóa bí mật ký cookie phiên đăng nhập (tạo bằng: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=replace-with-a-random-64-char-hex-secret

# Domain công khai của Dashboard (không có dấu / ở cuối), dùng tự dựng Redirect URI cho Discord OAuth2
# VD: https://your-bot-service.northflank.app hoặc http://localhost:10000
DASHBOARD_PUBLIC_URL=http://localhost:10000

# Login with Discord (OAuth2) — lấy trong Discord Developer Portal -> OAuth2 -> General
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_CLIENT_SECRET=your-discord-application-client-secret
# Tuỳ chọn: chỉ định thẳng Redirect URI (phải khớp chính xác với mục Redirects trong Discord Portal)
# DISCORD_REDIRECT_URI=https://your-bot-service.northflank.app/auth/discord/callback

# ==============================================================================
# KHỞI TẠO ADMIN ĐẦU TIÊN (tự động tạo 1 lần nếu collection đang trống)
# ==============================================================================
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMeStrongPassword123!
# Danh sách Discord User ID làm Admin đầu tiên (đồng thời có quyền Dashboard + /status)
INITIAL_ADMIN_DISCORD_IDS=1240503090185109536,1568530089035956284

# ==============================================================================
# TUỲ CHỌN KHỞI ĐỘNG / GIÁ TRỊ SEED BAN ĐẦU
# (Sau khi khởi động lần đầu, các thông số này được quản lý trực tiếp trên Web Dashboard)
# ==============================================================================
# GUILD_ID=123456789012345678
# GEMINI_API_VERSION=v1beta
# STATUS_ALLOWED_IDS=1240503090185109536,1568530089035956284
# SYSTEM_PROMPT=...
# USER_COOLDOWN=5
# MAX_CONCURRENT=2
# HIDDEN_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro,gemini-nano-banana-2.1,gemini-omni-flash-preview,gemini-4-argon,gemini-4-carbon
# EXTRA_MODELS=gemini-4-hydrogen
# HIDE_PRO_MODELS=1
# AUTO_LAST_MODEL=gemini-4-hydrogen
# AUTO_MODEL_CHAIN=
# DEFAULT_TEXT_MODEL=
# MODEL_REFRESH_HOURS=6
# SESSION_IDLE_HOURS=2
# SESSION_MAX_TURNS=500
# MAX_HISTORY_MESSAGES=20
# MAX_HISTORY_CHARS=24000
# SWEEP_MINUTES=5
# MONGODB_QUOTA_MB=512
# RAM_LIMIT_MB=256
